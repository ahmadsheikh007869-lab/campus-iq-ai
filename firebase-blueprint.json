{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and usage statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "usage": {
          "type": "object",
          "properties": {
            "voiceGenerations": { "type": "number" },
            "timeUsed": { "type": "number" },
            "credits": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Audio": {
      "title": "Audio Metadata",
      "description": "Metadata for generated audio files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "text": { "type": "string" },
        "voiceId": { "type": "string" },
        "voiceName": { "type": "string" },
        "audioUrl": { "type": "string" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "audioUrl"]
    },
    "Voice": {
      "title": "Cloned Voice",
      "description": "Metadata for cloned voices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sampleUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/audios/{audioId}": {
      "schema": "Audio",
      "description": "User's generated audio files"
    },
    "/users/{userId}/voices/{voiceId}": {
      "schema": "Voice",
      "description": "User's cloned voices"
    }
  }
}
