rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: userId (uid)
    // Fields: uid, email, displayName, photoURL, usage, createdAt
    
    // Collection: users/{userId}/audios
    // Fields: id, userId, title, prompt, text, voiceId, voiceName, audioUrl, duration, createdAt
    
    // Collection: users/{userId}/voices
    // Fields: id, userId, name, description, sampleUrl, createdAt

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string;
    }
    function isValidAudio(data) {
      return data.keys().hasAll(['userId', 'audioUrl']) &&
             data.userId is string &&
             data.audioUrl is string;
    }
    function isValidVoice(data) {
      return data.keys().hasAll(['userId', 'name']) &&
             data.userId is string &&
             data.name is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      
      match /audios/{audioId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAudio(request.resource.data);
        allow update: if isOwner(userId) && isValidAudio(request.resource.data);
        allow delete: if isOwner(userId);
      }
      
      match /voices/{voiceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVoice(request.resource.data);
        allow update: if isOwner(userId) && isValidVoice(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
