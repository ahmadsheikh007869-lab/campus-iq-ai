# ==============================================================================
# CampusIQ AI — Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE: Never commit real credentials or private keys to version
# control. Copy this file to '.env' and populate with your project credentials.
# ==============================================================================

# Supabase Client Configuration (Exposed to Vite frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Edge Functions / Backend LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Server & Runtime Configuration
PORT=8080
NODE_ENV=development
